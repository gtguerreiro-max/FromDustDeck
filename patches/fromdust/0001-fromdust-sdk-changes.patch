+# The FidelityFX components compile with /WX and pass GCC-style options (-O3, -ffp-model=strict,
+# -fno-char8_t) that clang-cl warns about, and their headers trip clang's -Wmissing-braces and
+# -Wmissing-field-initializers: with clang-cl as the compiler none of them builds. Their
+# warnings are not ours to fix, so warnings stay warnings there (/WX- after their /WX wins).
+function(_rexglue_ffx_no_werror dir)
+    get_property(_targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
+    foreach(_t IN LISTS _targets)
+        get_target_property(_type ${_t} TYPE)
+        if(_type MATCHES "LIBRARY|EXECUTABLE" AND NOT _type STREQUAL "INTERFACE_LIBRARY")
+            if(MSVC)
+                target_compile_options(${_t} PRIVATE /WX- -Wno-unused-command-line-argument
+                                                     -Wno-unknown-argument)
+            endif()
+            set_target_properties(${_t} PROPERTIES COMPILE_WARNING_AS_ERROR OFF)
+        endif()
+    endforeach()
+    get_property(_subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
+    foreach(_d IN LISTS _subdirs)
+        _rexglue_ffx_no_werror("${_d}")
+    endforeach()
+endfunction()
+_rexglue_ffx_no_werror("${fidelityfx_SOURCE_DIR}/ffx-api")
+
+# ffx_api_dll.rc (version information only) is UTF-16, which clang-cl cannot preprocess for
+# CMake's resource dependency scan: leave it out of the FidelityFX libraries.
+foreach(_t amd_fidelityfx_dx12 amd_fidelityfx_vk)
+    if(TARGET ${_t})
+        get_target_property(_sources ${_t} SOURCES)
+        list(FILTER _sources EXCLUDE REGEX "\\.rc$")
+        set_target_properties(${_t} PROPERTIES SOURCES "${_sources}")
+    endif()
+endforeach()
